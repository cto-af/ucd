{
  "name": "@cto.af/ucd",
  "version": "1.1.5",
  "decription": "Retrieve, cache, and parse current Unicode Character Database files.",
  "main": "lib/index.js",
  "type": "module",
  "keywords": [
    "unicode",
    "ucd",
    "tr44",
    "parse"
  ],
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cto-af/ucd.git"
  },
  "homepage": "https://github.com/cto-af/ucd#readme",
  "bugs": {
    "url": "https://github.com/cto-af/ucd/issues"
  },
  "files": [
    "lib/*"
  ],
  "scripts": {
    "clean": "rm -rf lib coverage docs src/ucd.js src/ucd.d.ts",
    "docs": "typedoc",
    "lint": "eslint .",
    "parser": "peggy -c peggy.config.js",
    "prebuild": "npm run parser",
    "build": "tsc",
    "postbuild": "cpy --flat src/ucd.js src/ucd.d.ts lib",
    "pretest": "tsc --inlineSourceMap",
    "test": "c8 node --test --enable-source-maps",
    "posttest": "tsc",
    "start": "hostlocal",
    "ci": "npm test && npm run lint && npm run docs"
  },
  "dependencies": {
    "@cto.af/log": "2.0.2",
    "@cto.af/utils": "2.0.1"
  },
  "devDependencies": {
    "@cto.af/eslint-config": "7.0.3",
    "@peggyjs/coverage": "^2.0.6",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cpy-cli": "^7.0.0",
    "enhanced-resolve": "^5.26.0",
    "eslint": "^10.12.0",
    "hostlocal": "^3.0.1",
    "peggy": "^5.1.1",
    "superc8": "^12.7.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  }
}
